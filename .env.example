# Leave both unset to run against the built-in local sample data (no account needed).
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_public_key
# Optional. Where invitation links point when sent from the phone app (the web app uses its own address).
EXPO_PUBLIC_APP_URL=https://your-owner.github.io/Itera-Connect/
